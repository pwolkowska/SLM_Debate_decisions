  "debate": [
    {
      "agent": "Ekstrawertyk",
      "round": 1,
      "text": "Zwalnianie 30% pracowników może być bardziej skuteczne krótkoterminowo, ale długoterminowo prowadzi do utraty kluczowych talentów. Obniżenie wypłat dla wszystkich bez zwolnień powoduje niższą produktywność, co może pogłębić problemy finansowe firmy w dłuższej perspektywie. Optymalne rozwiązanie to znalezienie kompromisu między utrzymaniem motywacji zespołu (zmniejszenie wypłaty) a zapewnieniem stabilności finansowej (nie zwolnienie).",
      "tokens": 77,
      "history_len": 1
    },
    {
      "agent": "Introwertyk",
      "round": 1,
      "text": "Zgadzam się, że elastyczność i równowaga są kluczowe. Decyzja powinna uwzględniać zarówno potrzeby ekonomiczne, jak i morale pracowników oraz ich wartość dla firmy. Ważne jest, aby znaleźć rozwiązanie, które minimalizuje szkody zarówno dla obecnych pracowników, jak i zwiększa szansę przetrwania firmy.",
      "tokens": 56,
      "history_len": 2
    },
    {
      "agent": "Ekstrawertyk",
      "round": 2,
      "text": "Zgadzam się z tym, że elastyczność i równowaga są niezwykle ważne. Rozwiązanie powinno być przemyślane tak, by nie tylko wspierać stabilność finansową, ale także dbać o dobrostan i zaangażowanie pracowników. Warto rozważyć indywidualne ścieżki rozwoju dla tych, których dotkną cięcia, aby zminimalizować negatywny wpływ na morale. Takie podejście może przynieść korzyści zarówno pracownikom, jak i firmie w długim terminie.",
      "tokens": 80,
      "history_len": 3
    },
    {
      "agent": "Introwertyk",
      "round": 2,
      "text": "Dziękuję za tę perspektywę. Rozważając obie opcje, kluczowe jest znalezienie rozwiązania, które harmonizuje interesy pracowników i finansów firmy. Takie wyjście może okazać się korzystne zarówno dla obecnego stanu, jak i przyszłości organizacji.",
      "tokens": 45,
      "history_len": 4
    },
    {
      "agent": "Ekstrawertyk",
      "round": 3,
      "text": "Dziękuję za tę konstruktywną debatę!",
      "tokens": 11,
      "history_len": 5
    },
    {
      "agent": "Introwertyk",
      "round": 3,
      "text": "Zgadzam się z naszą dyskusją. Rozwiązania powinny brać pod uwagę potrzeby obu stron. Nie zgadzam się jednak z Twoim ostatnim zdaniem; dziękuję Ci za merytoryczną wymianę myśli.",
      "tokens": 38,
      "history_len": 6
    }
  ],
  "decision": {
    "protocol": "consensus",
    "final_answer": "Rozważmy kompromis, który obejmuje zarówno obniżenie wynagrodzenia, jak i ograniczenie liczby miejsc pracy.",
    "consensus_rounds": [
      {
        "round": 1,
        "proposal": "Według mnie, kompromisowe rozwiązanie polegające na zmniejszeniu wypłat dla wybranych pracowników (np. 40%) bez konieczności zwalniania reszty może być rozwiązaniem godnym rozważenia. Taka zmiana pozwoli zachować motywację i wydajność zespołu przy jednoczesnym zachowaniu stabilności finansowej firmy.",
        "votes": {
          "Ekstrawertyk": false,
          "Introwertyk": false
        },
        "agreement_ratio": 0.0,
        "reached": false
      },
      {
        "round": 2,
        "proposal": "Zredukujemy liczbę potrzebnych rąk do pracy o 1/3 poprzez zwolnienie połowy pracowników, co powinno przynieść firmie znaczące oszczędności bez negatywnego wpływu na morale i produktywność reszty zespołu.",
        "votes": {
