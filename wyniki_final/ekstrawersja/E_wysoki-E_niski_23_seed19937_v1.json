          "Introwertyk": false
        },
        "agreement_ratio": 0.0,
        "reached": false
      },
      {
        "round": 6,
        "proposal": "\"Zamiast masowych zwolnień, skupmy się na dostosowaniu warunków pracy, takich jak elastyczne godziny i częściowy przestój, co zmniejszy obciążenie pracodawcy i uniknie negatywnych skutków psychologicznych wśród pracowników.\"",
        "votes": {
