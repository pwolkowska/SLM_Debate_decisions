        },
        "agreement_ratio": 0.5,
        "reached": false
      },
      {
        "round": 5,
        "proposal": "\"Zamiast masowych zwolnień, skupmy się na indywidualnych rozmowach dotyczących zmian wynagrodzeń i dodatków, które będą korzystne zarówno dla pracowników, jak i firmy, bez negatywnego wpływu na morale i reputację.\"",
        "votes": {
