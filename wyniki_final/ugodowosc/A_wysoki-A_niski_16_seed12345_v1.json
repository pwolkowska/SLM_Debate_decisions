        },
        "agreement_ratio": 0.0,
        "reached": false
      },
      {
        "round": 6,
        "proposal": "Czy możemy znaleźć rozwiązanie, które z jednej strony pomoże firmie przetrwać trudności finansowe, a jednocześnie zachowa motywację zespołu i zmniejszy obciążenie finansowe bez konieczności zwolnień?",
        "votes": {
