        },
        "agreement_ratio": 0.0,
        "reached": false
      },
      {
        "round": 6,
        "proposal": "\"Chętnie przyjmuję Twoje propozycje dotyczące wsparcia pracowników mimo trudności finansowych firmy - dodatkowe benefity mogą być skuteczniejsze niż radykalne cięcia wynagrodzeń, jednocześnie poprawiając atmosferę pracy!\"",
        "votes": {
