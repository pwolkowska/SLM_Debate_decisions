        },
        "agreement_ratio": 0.5,
        "reached": false
      },
      {
        "round": 2,
        "proposal": "\"Rozumiem trudności firmy. Proponuję rozważenie zarówno zwolnienia części pracowników (np. 10%), co pozwoliłoby na utrzymanie większej liczby osób przy pracy bez konieczności drastycznego obniżenia ich wynagrodzeń. Alternatywnie, obniżenie wypłat pozostałych pracowników o 15% może być mniej dotkliwe finansowo i pomóc utrzymać większą część zespołu przy firmie.\"",
        "votes": {
          "Ugodowy": true,
          "Niezależny": false
        },
        "agreement_ratio": 0.5,
        "reached": false
      },
      {
        "round": 3,
        "proposal": "Proponuję rozważyć restrukturyzację, polegającą na zwolnieniu mniejszej liczby pracowników, np. 10%, przy jednoczesnym obniżeniu pensji większości zatrudnionych o 15%. To podejście pozwala zachować więcej miejsc pracy i uniknąć masowych zwolnień.",
        "votes": {
          "Ugodowy": false,
