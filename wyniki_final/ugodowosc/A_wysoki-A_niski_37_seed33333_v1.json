        },
        "agreement_ratio": 0.0,
        "reached": false
      },
      {
        "round": 4,
        "proposal": "Zgadzam się z propozycją rozważenia redukcji zatrudnienia o 10%, ale jednocześnie proponuję obniżenie wynagrodzeń dla wszystkich pracowników o 15%, co pozwoli zachować większą liczbę etatów i zapewni sprawiedliwe rozłożenie obciążeń finansowych firmy.",
        "votes": {
          "Ugodowy": true,
