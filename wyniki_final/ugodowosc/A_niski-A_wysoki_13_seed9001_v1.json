        "agreement_ratio": 0.0,
        "reached": false
      },
      {
        "round": 3,
        "proposal": "Jeśli chodzi o znalezienie kompromisu, rozważmy możliwość redukcji zatrudnienia (np. 30%) przy jednoczesnym obniżeniu pensji pozostałym pracownikom (np. o 20%). Takie rozwiązanie pomoże zachować kluczowe zasoby ludzkie oraz zapewnić stabilność zatrudnienia i motywację wszystkim zatrudnionym.",
        "votes": {
          "Niezależny": false,
