  "decision": {
    "protocol": "consensus",
    "final_answer": "Rozważmy możliwość obniżenia wynagrodzeń wszystkich pracowników o 10%, co pozwoli zmniejszyć koszty firmy i chronić ponad połowę stanowisk, jednocześnie zachowując równowagę ekonomiczną.",
    "consensus_rounds": [
      {
        "round": 1,
