        },
        "agreement_ratio": 0.0,
        "reached": false
      },
      {
        "round": 3,
        "proposal": "Oferuję kompromisowe podejście polegające na **obniżeniu płac** większości pracowników o 20% oraz znalezieniu **nowych źródeł dochodów** lub reorganizacji struktury firmy w celu ochrony miejsc pracy. Proponuję to rozwiązanie jako sposób na utrzymanie morale zespołu przy jednoczesnej ochronie kluczowych stanowisk i efektywności pracy.",
        "votes": {
          "Ugodowy": false,
