        },
        "agreement_ratio": 0.0,
        "reached": false
      },
      {
        "round": 6,
        "proposal": "\"Zamiast radykalnie obniżać wynagrodzenia większości pracowników, skupmy się na poprawie procesów i technologii, co przyniesie długoterminowe korzyści dla całej organizacji.\"",
        "votes": {
