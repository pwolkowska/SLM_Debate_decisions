        "agreement_ratio": 0.5,
        "reached": false
      },
      {
        "round": 3,
        "proposal": "\"\"Jeśli mamy trudności finansowe, proponuję zrewidować wynagrodzenia wszystkich pracowników proporcjonalnie - zamiast masowych zwolnień, co może prowadzić do frustracji i potencjalnej utraty kluczowych zasobów ludzkich.\"\"",
        "votes": {
